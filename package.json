{
  "name": "flyingmouse-format",
  "version": "0.3.2",
  "private": true,
  "author": "LaoFeng",
  "productName": "FlyingMouse Format",
  "description": "Windows desktop universal file format converter (offline, bundled FFmpeg/LibreOffice/Poppler/Tesseract).",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:win7": "node scripts/build-win7.js",
    "test": "node --test tests/av3a-format.test.js tests/conversion-preferences.test.js tests/i18n.test.js tests/settings-store.test.js tests/conversion.test.js tests/electron-hardening-static.test.js tests/electron-security.test.js tests/logger.test.js tests/mouse-assets.test.js tests/ui-static.test.js tests/win7-build-profile.test.js tests/win7-build-script.test.js tests/pe-metadata.test.js",
    "test:ci": "node --test tests/av3a-format.test.js tests/conversion-preferences.test.js tests/i18n.test.js tests/settings-store.test.js tests/electron-hardening-static.test.js tests/electron-security.test.js tests/logger.test.js tests/mouse-assets.test.js tests/ui-static.test.js tests/win7-build-profile.test.js tests/win7-build-script.test.js tests/pe-metadata.test.js"
  },
  "dependencies": {
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "mammoth": "^1.12.0",
    "mime-types": "^2.1.35",
    "multer": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "sanitize-filename": "^1.6.3",
    "sharp": "^0.35.3",
    "sql.js": "^1.14.1",
    "tesseract.js": "^7.0.0",
    "turndown": "^7.2.4",
    "yazl": "^3.3.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.flyingmouse.format",
    "productName": "FlyingMouse Format",
    "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.js",
      "electron-security.js",
      "preload.js",
      "server.js",
      "logger.js",
      "settings-store.js",
      "ncm-format.js",
      "av3a-format.js",
      "kgg-format.js",
      "public/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "bin/ffmpeg/ffmpeg.exe",
        "to": "ffmpeg/ffmpeg.exe"
      },
      {
        "from": "bin/avs3",
        "to": "avs3"
      },
      {
        "from": "bin/libreoffice",
        "to": "libreoffice"
      },
      {
        "from": "bin/poppler",
        "to": "poppler"
      },
      {
        "from": "bin/tessdata",
        "to": "tessdata"
      },
      {
        "from": "node_modules/tesseract.js-core",
        "to": "tesseract.js-core"
      }
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/tesseract.js/**/*",
      "node_modules/tesseract.js-core/**/*",
      "node_modules/sql.js/**/*"
    ],
    "win": {
      "signExecutable": false,
      "target": [
        "nsis",
        "appx"
      ],
      "signtoolOptions": {
        "certificateSha1": "0EEEFD57DA202C56D95A63437C385F6FFB772527",
        "signingHashAlgorithms": [
          "sha256"
        ]
      }
    },
    "appx": {
      "applicationId": "FlyingMouseFormat",
      "identityName": "488B6338.354574AC174AD",
      "publisher": "CN=56D7A4A1-B653-4162-A5E2-7D9B3F3754AD",
      "publisherDisplayName": "牢蜂喜欢开飞机",
      "displayName": "FlyingMouse Format",
      "languages": [
        "zh-CN",
        "en-US"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FlyingMouse Format"
    }
  }
}
